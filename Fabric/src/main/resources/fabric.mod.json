{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["${mod_author}"],
	"license": "${license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.romoslayer.seasonfall.fabric.SeasonfallFabric"],
		"client": ["dev.romoslayer.seasonfall.fabric.SeasonfallFabricClient"]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${fabric_minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
